/* ---- Configuration ---- */
configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "Applications: ";
    drun-display-format:        "{name}";
    font:                        "JetBrainsMono Nerd Font 11";
}

/* ---- Load font ---- */
@import "~/.config/rofi/settings/rofi-font.rasi"

/* ---- Load pywal colors ---- */
@import "~/.cache/wal/colors-rofi-pywal"
@import "~/.cache/wal/colors-rofi-dark"

/* ---- Load border width ---- */
@import "~/.config/rofi/settings/rofi-border.rasi"

/* ---- Window ---- */
window {
    width:                        800px;
    x-offset:                     0px;
    y-offset:                     0px;
    spacing:                      0px;
    padding:                      0px;
    margin:                       0px; 
    border:                       2px;
    border-color:                 @color11;
    cursor:                       "default";
    transparency:                 "real";
    location:                     center;
    anchor:                       center;
    fullscreen:                   false;
    enabled:                      true;
    border-radius:                0px;
    background-color:             @background;
    font:                         "JetBrainsMono Nerd Font 14";
}

/* ---- Mainbox ---- */
mainbox {
    enabled:                      true;
    orientation:                  vertical;
    spacing:                      0px;
    margin:                       0px;
    background-color:             transparent;
    children:                     ["inputbar", "listbox"];
}

/* ---- Inputbar (The Header Bar) ---- */
inputbar {
    enabled:                      true;
    text-color:                   @foreground;
    spacing:                      0px;
    padding:                      15px 20px;
    background-color:             @color11; /* Uses your pywal accent color for the bar */
    children:                     [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
}

entry {
    enabled:                      true;
    background-color:             transparent;
    text-color:                   inherit;
    cursor:                       text;
    placeholder:                  "";
}

/* ---- Listbox ---- */
listbox {
    spacing:                     0px;
    padding:                     10px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                      true;
    columns:                      1;
    lines:                        8;
    cycle:                        false;
    dynamic:                      true;
    scrollbar:                    false;
    layout:                       vertical;
    reverse:                      false;
    fixed-height:                 true;
    fixed-columns:                true;
    spacing:                      5px;
    padding:                      10px;
    background-color:             transparent;
    border:                       0px;
}

/* ---- Element ---- */
element {
    enabled:                      true;
    padding:                      8px 10px;
    margin:                       0px;
    cursor:                       pointer;
    background-color:             transparent;
    border-radius:                4px;
    border:                       0px;
    text-color:                   @foreground;
}

element selected.normal {
    background-color:             @color11;
    text-color:                   @background; /* Contrast text for selection */
}

element-icon {
    background-color:             transparent;
    size:                         28px;
    cursor:                       inherit;
    padding:                      0px 15px 0px 0px;
}

element-text {
    background-color:             transparent;
    text-color:                   inherit;
    vertical-align:               0.5;
    horizontal-align:             0.0;
}

/* ---- Message / Error ---- */
message {
    background-color:            transparent;
    border:                      0px;
    margin:                      0px;
    padding:                     0px;
}

textbox {
    padding:                     15px;
    background-color:            @background;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
