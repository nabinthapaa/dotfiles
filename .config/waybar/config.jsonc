{
  "layer": "bottom",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock", 
  ],
  "modules-right": [
    "pulseaudio",
    "custom/bluetooth-volume",
    "battery",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/lock",
  ],
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": "",
    },
  },
	"battery": {
		"format": "{icon} {capacity}%",
		"tooltip-format-charging": "Full in: {time}\nPower Draw: {power}watts\nHealth: {health}%\nCycles: {cycles}",
		"tooltip-format-discharging": "Full in: {time}\nPower Draw: {power}watts\nHealth: {health}%\nCycles: {cycles}",
		"format-icons": {
			"default": " ",
			"charging": "", 
			"warning": "",
			"critical": ""
		},

		"states" : {
			"warning" : 30,
			"critical" : 20,
		},
	},
  "tray": {
    "icon-size": 21,
    "spacing": 10,
  },
  "clock": {
    "timezone": "$TZ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%Y/%m/%d - %H:%M}",
  },
  "network": {
    "format-wifi": "  {essid} {bandwidthTotalBits}",
    "format-ethernet": "󰈀 Wired {bandwidthTotalBits}",
    "format-disconnected": "Disconnected",
    "format": "{ifname} {bandwidthTotalBits}",
    "tooltip-format": " {essid} via {gwaddri}",
    "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "tooltip": true,
    "max-length": 50,
    "on-click": "$HOME/.config/hypr/scripts/check-nmtui",
  },
  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"on-click": "$HOME/.config/hypr/scripts/check-btop"
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G",
		"on-click": "$HOME/.config/hypr/scripts/check-btop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-bluetooth": " {volume}%",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", " "],
    },
    "on-click": "pavucontrol",
  },

  "custom/bluetooth-volume": {
      "exec": "~/.config/hypr/scripts/bluetooth",
      "interval": 1000,
      "format": "{text}",
      "tooltip": true,
      "on-click": "pavucontrol"
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "wlogout",
    "format": "",
  },
  "later": {
    "format": "<span class='icon'>{icon}</span> <span class='text'>{text}</span>",
  },
}
