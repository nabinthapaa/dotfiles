#!/bin/bash

# ==============================================================================
# SCRIPT CONFIGURATION
# ==============================================================================

# Directories
WALLPAPER_DIR="$HOME/wallpaper"
CACHE_DIR="$HOME/.cache/wal"
MAGICK_CACHE="$HOME/.cache/ImageMagick"

# Output filenames
BLURRED_OUTPUT="blurred_wallpaper.png"
SQUARED_OUTPUT="square_image.png"
NOTIFICATION_OUTPUT="notification_image.png"

# Hyprpaper config
HYPRPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"

# ==============================================================================
# SCRIPT LOGIC
# ==============================================================================

# Check dependencies
if ! command -v rofi &>/dev/null || ! command -v magick &>/dev/null || ! command -v hyprctl &>/dev/null; then
  notify-send "Error: Required dependencies (rofi, magick, hyprctl) are not installed."
  exit 1
fi

# Get list of active monitors
MONITORS=$(hyprctl monitors -j | jq -r '.[] | .name')

# Select image using rofi
SELECTED_FILE=$(find "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) |
  while read -r FILE; do
    echo -en "$FILE\x00icon\x1f$FILE\n"
  done |
  rofi -dmenu -i -p "Select Wallpaper: ")

# Cancelled?
if [[ -z "$SELECTED_FILE" ]]; then
  exit 0
fi

# Create necessary directories
mkdir -p "$CACHE_DIR" "$MAGICK_CACHE"

# Generate hash for caching
FILE_HASH=$(sha256sum "$SELECTED_FILE" | cut -d ' ' -f1)
BLURRED_HASH="$CACHE_DIR/${FILE_HASH}_blurred.png"
SQUARED_HASH="$CACHE_DIR/${FILE_HASH}_square.png"
NOTIFICATION_HASH="$CACHE_DIR/${FILE_HASH}_notification.png"
BLURRED_PATH="$CACHE_DIR/$BLURRED_OUTPUT"
SQUARED_PATH="$CACHE_DIR/$SQUARED_OUTPUT"
SQUARED_PATH="$CACHE_DIR/$NOTIFICATION_OUTPUT"

# Pre-load the wallpaper
hyprctl hyprpaper preload "$SELECTED_FILE"

# Apply wallpaper to ALL detected monitors
for MONITOR in $MONITORS; do
  hyprctl hyprpaper wallpaper "$MONITOR,$SELECTED_FILE"
done

notify-send "Wallpaper Changed" "Applied to: $(echo $MONITORS | tr '\n' ' ')"

# --- Image Processing (Async for speed) ---

# Get dimensions and process
read -r WIDTH HEIGHT <<<"$(magick identify -format "%w %h" "$SELECTED_FILE")"
MIN_DIM=$((WIDTH < HEIGHT ? WIDTH : HEIGHT))

if [[ ! -f "$BLURRED_HASH" ]]; then
  magick "$SELECTED_FILE" -gaussian-blur 0x5 "$BLURRED_HASH"
fi
cp "$BLURRED_HASH" "$BLURRED_PATH"

if [[ ! -f "$SQUARED_HASH" ]]; then
  magick "$SELECTED_FILE" -gravity center -crop "${MIN_DIM}x${MIN_DIM}+0+0" "$SQUARED_HASH"
fi
cp "$SQUARED_HASH" "$SQUARED_PATH"

if [[ ! -f "$NOTIFICATION_HASH" ]]; then
  magick "$SELECTED_FILE" -gravity center -crop "40x40+0+0" "$NOTIFICATION_HASH"
fi
cp "$NOTIFICATION_HASH" "$NOTIFICATION_PATH"

# --- Update Hyprpaper Config File ---

# We rebuild the config to ensure all monitors are accounted for
echo "preload = $SELECTED_FILE" >"$HYPRPAPER_CONF"
for MONITOR in $MONITORS; do
  echo "wallpaper = $MONITOR,$SELECTED_FILE" >>"$HYPRPAPER_CONF"
done

# Optional: Keep other lines if you have custom splashes
echo "splash = false" >>"$HYPRPAPER_CONF"

hyprctl reload
notify-send "Lockscreen & Config Updated"
